# Server-only secret. Add your key in .env.local or your host's environment.
# Never prefix this with NEXT_PUBLIC_. Restart the app after changing it.
OPENROUTER_API_KEY=
# Preferred FREE models in generation order; live availability and prices are checked.
OPENROUTER_MODELS=thinkingmachines/inkling:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Required in production. The studio token is separate from the provider key.
STUDIO_ACCESS_TOKEN=
# Optional system Chrome/Edge path; otherwise npm run browser:install.
CHROMIUM_EXECUTABLE_PATH=
