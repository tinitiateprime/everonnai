# Server-only secret. Add your key in .env.local or your host's environment.
# Never prefix this with NEXT_PUBLIC_. Restart the app after changing it.
OPENROUTER_API_KEY=
# Server-only Pexels photography key. Never use NEXT_PUBLIC_.
PEXELS_API_KEY=
# Configured website models in version order. These use paid OpenRouter credits.
# OpenRouter latest-family aliases require the leading ~. Fallback stays within this list.
OPENROUTER_MODELS=~anthropic/claude-opus-latest,~google/gemini-pro-latest,openai/gpt-6.1-sol
# Optional: set to "gemini" to plan/generate/refine websites directly with GEMINI_API_KEY
# instead of OpenRouter. Models are in version order; each version starts on its own model.
WEBSITE_PROVIDER=
GEMINI_WEBSITE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# Voice/chat booking: Google OAuth web client (Calendar + Gmail send scopes). Register
# http://localhost:3000/api/integrations/google/callback (or your host's URL) as an
# authorized redirect URI. Tokens are encrypted with CREDENTIAL_ENCRYPTION_KEY (32+ chars).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
# Optional: fixed redirect URI behind proxies; optional storage directory (default data/integrations).
GOOGLE_OAUTH_REDIRECT_URI=
INTEGRATIONS_DIR=
# Required in production. The studio token is separate from the provider key.
STUDIO_ACCESS_TOKEN=
# Optional system Chrome/Edge path; otherwise npm run browser:install.
CHROMIUM_EXECUTABLE_PATH=
# Optional writable persistent directory for generated website URLs.
# Default: data/generated-sites inside this studio checkout.
GENERATED_SITES_DIR=
# Public-site discovery: bounded requests save progress and resume between batches.
# Project scans reuse these settings and cap batch duration at 45 seconds.
CRAWL_MAX_PAGES=500
CRAWL_BATCH_PAGES=40
CRAWL_BATCH_SECONDS=75
CRAWL_CONCURRENCY=4
# Optional persistent directory; default data/crawls. Continuation supports up to 2,000 pages.
CRAWL_STORAGE_DIR=
# Same provider setup as the main project. Server-only credentials.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Text fallback if live ElevenLabs chat cannot connect.
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODELS=gemini-3.8-flash

# Project workspace, owned discovery and snapshots. Existing studio generation is configured above.
# PostgreSQL migrations require an administrator capable of creating the restricted
# everonn_platform_app role. Request transactions always assume that restricted role.
DATABASE_URL=
# Optional separate administrator connection used only by npm run db:migrate.
DATABASE_MIGRATION_URL=
# Fixed HTTPS origin for workspace login/CSRF validation (no trailing path).
AUTH_BASE_URL=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_SESSION_SECRET=
# S3-compatible private artifact storage, or managed AWS credential identity.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Explicit local-only PGlite/filesystem/development login. Disabled in production.
# npm run platform:dev enables these only for its loopback development process.
PLATFORM_LOCAL_MODE=
PLATFORM_DEV_AUTH=
PLATFORM_DATABASE_DIR=
PLATFORM_OBJECTS_DIR=
PLATFORM_DEV_PORT=3000
