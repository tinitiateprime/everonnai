# Public application origin, used by state-changing API origin checks.
# On Amplify, set this to the exact HTTPS site origin (without /login).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AgenticThat-compatible Gemini website generation. GEMINI_API_KEY is preferred;
# GOOGLE_API_KEY remains supported as the same fallback alias used upstream.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000
GEMINI_WEBSITE_MODEL=
GEMINI_WEBSITE_MODELS=
GEMINI_WEBSITE_TIMEOUT_MS=55000
GEMINI_WEBSITE_RETRY_DELAY_MS=900

# AgenticThat-compatible website media provider.
PEXELS_API_KEY=

# Optional ElevenLabs pilot voice provider. Both values are required for live
# sessions; the built-in browser voice and typed call demo need no secrets.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional JSON workspace locations. The primary workspace defaults to
# ./data/everonn.json and self-registered workspaces to ./data/workspaces.json.
# Use absolute paths when data should live outside the application folder.
EVERONN_DATA_FILE=
EVERONN_WORKSPACES_FILE=
EVERONN_CONNECTIONS_FILE=

# JSON-backed authentication. In production, set a long random setup token
# before the first owner account is created. The auth file contains password
# hashes and server sessions and must never be committed.
EVERONN_AUTH_FILE=
EVERONN_AUTH_SETUP_TOKEN=

# Google Calendar + Gmail OAuth adapters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth callback is derived from the current application origin.
CREDENTIAL_ENCRYPTION_KEY=

# Optional AgenticThat service-account calendar credential. OAuth remains the
# preferred path when Calendar and Gmail are used together.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_BASE64=

# Reserved for future transactional email; not used by the current flows.
RESEND_API_KEY=
AUTH_EMAIL_FROM=EverOnn <hello@example.com>
