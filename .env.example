# npm run setup creates .env.local and generates this server-only access key.
WAAS_API_KEY=
WAAS_PUBLIC_URL=http://localhost:3000

# Required for real website generation. Use models available to YOUR account.
GEMINI_API_KEY=
# Optional ordered overrides; the engine otherwise defaults to gemini-3.8-flash.
GEMINI_WEBSITE_MODELS=
# Optional stock photography; without it, websites contain no stock images.
PEXELS_API_KEY=

# Production: your own PostgreSQL database (Supabase PostgreSQL also works).
# Run npm run db:migrate once with a user allowed to create schema/tables.
DATABASE_URL=
# Optional; "disable" is accepted only for localhost PostgreSQL.
DATABASE_SSL=
# Optional custom database CA in PEM, using literal \n for line breaks.
# Supabase hosts automatically use the bundled public Supabase CA.
DATABASE_CA_CERT=

# Development automatically uses ./data. Local files need a writable disk.
WAAS_DATA_DIR=
# Set true only for one production Node process with a persistent disk.
WAAS_ALLOW_LOCAL_STORAGE=false
# Optional comma-separated HTTPS origins allowed to iframe public sites.
# Blank permits any website to embed a published site. Private previews stay same-origin.
WAAS_EMBED_ORIGINS=

# Optional engine settings. Interactive AI calls remain capped at 20 seconds.
# Defaults: content/code standalone calls 150000 ms; retry delay 900 ms.
GEMINI_WEBSITE_TIMEOUT_MS=150000
GEMINI_WEBSITE_CODE_TIMEOUT_MS=150000
GEMINI_WEBSITE_RETRY_DELAY_MS=900
# Optional shared fallback model and key alias.
GEMINI_MODEL=
GOOGLE_API_KEY=
GEMINI_TIMEOUT_MS=25000
# Estimates only: list-price, paid or free. This never changes provider billing.
GEMINI_BILLING_TIER=list-price
