# Public application origin, used by state-changing API origin checks.
# On Amplify, set this to the exact HTTPS site origin (without /login).
# Current production: https://main.d2b3qy6tcyxz0p.amplifyapp.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AgenticThat-compatible Gemini website generation. GEMINI_API_KEY is preferred;
# GOOGLE_API_KEY remains supported as the same fallback alias used upstream.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000
GEMINI_WEBSITE_MODEL=
GEMINI_WEBSITE_MODELS=
GEMINI_WEBSITE_TIMEOUT_MS=150000
GEMINI_WEBSITE_CODE_TIMEOUT_MS=150000
GEMINI_WEBSITE_RETRY_DELAY_MS=900
# list-price (default) estimates paid-tier standard text costs without assuming
# the API key is paid. Set paid or free only after verifying the provider account.
GEMINI_BILLING_TIER=list-price

# AgenticThat-compatible website media provider.
PEXELS_API_KEY=

# Optional ElevenLabs pilot voice provider. Both values are required for live
# sessions; the built-in browser voice and typed call demo need no secrets.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Usage reconciliation also requires conversation read/list permissions on this key.
ELEVENLABS_WEBHOOK_SECRET=

# Optional JSON workspace locations. The primary workspace defaults to
# ./data/everonn.json and self-registered workspaces to ./data/workspaces.json.
# Use absolute paths when data should live outside the application folder.
EVERONN_DATA_FILE=
EVERONN_WORKSPACES_FILE=
EVERONN_CONNECTIONS_FILE=
# Provider usage defaults to an ignored usage/ directory beside EVERONN_DATA_FILE.
# Netlify uses the everonn-usage Blob store automatically.
EVERONN_USAGE_DIR=
# Supabase usage uses a dedicated everonn_usage schema in the existing project.
# Preferred: private PostgreSQL access through the transaction pooler (port 6543).
# Apply npm run usage:db:migrate and npm run app:db:migrate first.
# The same connection uses private everonn_usage and everonn_app schemas.
# Credentials are server-only; no application schema is exposed to the Data API.
SUPABASE_DB_URL=
# Optional Data API access when no DB URL is configured. This requires adding
# everonn_usage to Exposed schemas while preserving existing schema entries.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted, never an anon/public key.
# Set this to everonn_usage when configuring Supabase; leave blank for local JSON.
SUPABASE_USAGE_SCHEMA=
USAGE_REQUIRE_DURABLE_STORAGE=false
# Amplify forces true for accounts/workspaces/encrypted Google connections too.
EVERONN_REQUIRE_DURABLE_STORAGE=false
# in-process for a continuously running local Node server; external on Amplify.
USAGE_BACKGROUND_MODE=
# At least 32 random characters. Used only by the scheduled /api/usage/jobs caller.
USAGE_CRON_SECRET=
# Optional actual Gemini charges from a workspace-dedicated Google project.
# Configure Cloud Billing export first, then a read-only billing service account.
# Never map a shared provider project to one customer workspace.
GEMINI_BILLING_SERVICE_ACCOUNT_BASE64=
GEMINI_BILLING_TABLE=
GEMINI_BILLING_PROJECT_ID=
GEMINI_BILLING_SERVICE_ID=
GEMINI_BILLING_WORKSPACE_ID=
GEMINI_BILLING_TIME_ZONE=UTC

# Application authentication (private Supabase on Amplify; JSON/Blobs otherwise).
# In production, set a long random setup token
# before the first owner account is created. The auth file contains password
# hashes and server sessions and must never be committed.
EVERONN_AUTH_FILE=
EVERONN_AUTH_SETUP_TOKEN=

# Optional local customer repository store (PostgreSQL / Netlify Blobs in their configured runtimes).
EVERONN_PROJECTS_FILE=

# Google Calendar + Gmail OAuth adapters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth callback is derived from the current application origin.
# Also encrypts customer GitHub repository access tokens.
CREDENTIAL_ENCRYPTION_KEY=

# Optional AgenticThat service-account calendar credential. OAuth remains the
# preferred path when Calendar and Gmail are used together.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_BASE64=

# Reserved for future transactional email; not used by the current flows.
RESEND_API_KEY=
AUTH_EMAIL_FROM=EverOnn <hello@example.com>
