# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AgenticThat-compatible Gemini website generation. GEMINI_API_KEY is preferred;
# GOOGLE_API_KEY remains supported as the same fallback alias used upstream.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000
GEMINI_WEBSITE_MODEL=
GEMINI_WEBSITE_MODELS=
GEMINI_WEBSITE_TIMEOUT_MS=55000
GEMINI_WEBSITE_RETRY_DELAY_MS=900

# AgenticThat-compatible website media provider.
PEXELS_API_KEY=

# Optional ElevenLabs pilot voice provider. Both values are required for live
# sessions; the built-in browser voice and typed call demo need no secrets.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional JSON workspace location. Defaults to ./data/everonn.json.
# Use an absolute path when the data should live outside the application folder.
EVERONN_DATA_FILE=
EVERONN_CONNECTIONS_FILE=

# Google Calendar + Gmail OAuth adapters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
CREDENTIAL_ENCRYPTION_KEY=

# Optional AgenticThat service-account calendar credential. OAuth remains the
# preferred path when Calendar and Gmail are used together.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_BASE64=

# Transactional preview and invitation email.
RESEND_API_KEY=
AUTH_EMAIL_FROM=EverOnn <hello@example.com>
