{
  "name": "@everonn/waas-service",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "smoke": "node --conditions=react-server --import tsx scripts/smoke.ts",
    "sdk:pack": "npm pack ./sdk",
    "setup": "node scripts/setup.mjs",
    "verify:live": "node --conditions=react-server --import tsx scripts/verify-live.ts",
    "standalone:prepare": "node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "css-tree": "3.2.1",
    "next": "16.3.8",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
